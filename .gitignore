# ── .NET build artifacts ───────────────────────────────────────────
**/bin/
**/obj/
**/.nuget/
*.user
*.userosscache
*.sln.doccache
.vs/
[Dd]ebug/
[Rr]elease/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
Log/
Logs/

# ── IDE ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── System files ───────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Environment / Secrets ──────────────────────────────────────────
# Never commit real credentials — use .env.example as a template
.env
.env.local
.env.*.local

# ── Database ───────────────────────────────────────────────────────
# Legacy SQLite files (project now uses PostgreSQL)
*.db
*.db-shm
*.db-wal

# ── Terraform ──────────────────────────────────────────────────────
# Provider lock file is tracked; working directory is not
**/.terraform/

# ── Kubernetes secrets ─────────────────────────────────────────────
devops/kubernetes/secrets.env
devops/kubernetes/sealed-secret.yaml
devops/kubernetes/*-secret.yaml
!devops/kubernetes/*.example
!devops/kubernetes/*.template

# ── Test results & coverage ────────────────────────────────────────
TestResults/
coverage/
*.coverage
*.coveragexml
