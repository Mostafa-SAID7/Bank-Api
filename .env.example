# ──────────────────────────────────────────────────────────────────
# Bank API — Environment Variables Template
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.
# ──────────────────────────────────────────────────────────────────

# ── Database ───────────────────────────────────────────────────────
# Standard PostgreSQL URI format (required)
DATABASE_URL=postgresql://user:password@localhost:5432/bankdb

# Neon-hosted override (optional — takes precedence over DATABASE_URL)
# NEON_DATABASE_URL=postgresql://user:password@ep-xxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── JWT ────────────────────────────────────────────────────────────
# Secret key for signing JWT tokens (required, min 32 characters)
JWT_KEY=your-very-long-and-secure-jwt-secret-key-at-least-32-chars

# ── ASP.NET Core ───────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# ── Email / SMTP (optional) ────────────────────────────────────────
# Required only if email notifications are enabled
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
